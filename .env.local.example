# URL del sitio (obligatorio para producción)
NEXT_PUBLIC_SITE_URL=https://tudominio.com

# --- Lead Pipeline ---
# Endpoint para entrega de leads del formulario de /architecture-review
# Compatible con Formspree, Web3Forms, o cualquier API que acepte POST JSON
# Si no se configura, los leads se loguean a consola (modo desarrollo)
LEAD_ENDPOINT_URL=https://formspree.io/f/tu-form-id

# Key opcional para servicios que requieren autenticación Bearer
LEAD_ENDPOINT_KEY=
